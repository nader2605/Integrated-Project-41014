<mujoco model="Track A Mobile Robot">
    <option timestep="0.02" gravity="0 0 -9.81"/>

    <visual>
        <global offwidth="640" offheight="480"/>
    </visual>

    <asset>
        <texture name="aruco" type="2d" file="assets/aruco_0.png"/>
        <material name="aruco_material" texture="aruco" texrepeat="1 1" texuniform="true" reflectance="0"/>
    </asset>

    <worldbody>
        <light pos="0 0 5" diffuse="0.9 0.9 0.9"/>
        <geom name="floor" type="plane" size="3 3 0.1" rgba="0.32 0.34 0.36 1"/>

        <geom name="wall_left"  type="box" pos="0 3 0.5"  size="3 0.05 0.5" rgba="0.7 0.7 0.7 1"/>
        <geom name="wall_right" type="box" pos="0 -3 0.5" size="3 0.05 0.5" rgba="0.7 0.7 0.7 1"/>
        <geom name="wall_back"  type="box" pos="-3 0 0.5" size="0.05 3 0.5" rgba="0.7 0.7 0.7 1"/>
        <geom name="wall_front" type="box" pos="3 0 0.5"  size="0.05 3 0.5" rgba="0.7 0.7 0.7 1"/>

        <geom name="obstacle_red" type="box" pos="-0.80 0.70 0.30" size="0.25 0.25 0.30" rgba="0.85 0.15 0.15 1"/>
        <geom name="obstacle_orange" type="box" pos="0 -0.60 0.30" size="0.25 0.25 0.30" rgba="0.95 0.45 0.10 1"/>
        <geom name="obstacle_green" type="box" pos="0.70 0.70 0.30" size="0.25 0.25 0.30" rgba="0.15 0.75 0.25 1"/>

        <body name="dock" pos="2.45 0 0">
            <geom name="dock_back" type="box" pos="0 0 0.55" size="0.05 0.52 0.55" rgba="0.15 0.15 0.15 1"/>
            <geom name="aruco_panel" type="box" pos="-0.058 0 0.55" size="0.008 0.34 0.34" material="aruco_material"/>
        </body>

        <body name="robot" pos="-2.05 -1.35 0.13">
            <freejoint name="robot_free"/>
            <geom name="robot_body" type="cylinder" size="0.18 0.10" rgba="0.10 0.35 0.95 1"/>
            <geom name="robot_nose" type="box" pos="0.16 0 0" size="0.07 0.035 0.035" rgba="1 0.9 0.1 1"/>
            <camera name="robot_camera" pos="0.18 0 0.12" euler="0 -90 0" fovy="60"/>

            <site name="lidar_m90" pos="0 0 0.12" zaxis="0 -1 0" size="0.008"/>
            <site name="lidar_m75" pos="0 0 0.12" zaxis="0.258819 -0.965926 0" size="0.008"/>
            <site name="lidar_m60" pos="0 0 0.12" zaxis="0.500000 -0.866025 0" size="0.008"/>
            <site name="lidar_m45" pos="0 0 0.12" zaxis="0.707107 -0.707107 0" size="0.008"/>
            <site name="lidar_m30" pos="0 0 0.12" zaxis="0.866025 -0.500000 0" size="0.008"/>
            <site name="lidar_m15" pos="0 0 0.12" zaxis="0.965926 -0.258819 0" size="0.008"/>
            <site name="lidar_0"   pos="0 0 0.12" zaxis="1 0 0" size="0.008"/>
            <site name="lidar_p15" pos="0 0 0.12" zaxis="0.965926 0.258819 0" size="0.008"/>
            <site name="lidar_p30" pos="0 0 0.12" zaxis="0.866025 0.500000 0" size="0.008"/>
            <site name="lidar_p45" pos="0 0 0.12" zaxis="0.707107 0.707107 0" size="0.008"/>
            <site name="lidar_p60" pos="0 0 0.12" zaxis="0.500000 0.866025 0" size="0.008"/>
            <site name="lidar_p75" pos="0 0 0.12" zaxis="0.258819 0.965926 0" size="0.008"/>
            <site name="lidar_p90" pos="0 0 0.12" zaxis="0 1 0" size="0.008"/>
        </body>
    </worldbody>

    <sensor>
        <rangefinder name="range_m90" site="lidar_m90"/>
        <rangefinder name="range_m75" site="lidar_m75"/>
        <rangefinder name="range_m60" site="lidar_m60"/>
        <rangefinder name="range_m45" site="lidar_m45"/>
        <rangefinder name="range_m30" site="lidar_m30"/>
        <rangefinder name="range_m15" site="lidar_m15"/>
        <rangefinder name="range_0"   site="lidar_0"/>
        <rangefinder name="range_p15" site="lidar_p15"/>
        <rangefinder name="range_p30" site="lidar_p30"/>
        <rangefinder name="range_p45" site="lidar_p45"/>
        <rangefinder name="range_p60" site="lidar_p60"/>
        <rangefinder name="range_p75" site="lidar_p75"/>
        <rangefinder name="range_p90" site="lidar_p90"/>
    </sensor>
</mujoco>
